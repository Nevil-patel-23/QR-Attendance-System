# QR Attendance System — Environment Variables
# Copy this file to .env and fill in your actual values

# ── Database ──────────────────────────────────────────────────────────
DB_URL=URL
DB_USERNAME=ID
DB_PASSWORD=PASS
# ── JWT Authentication ─────────────────────────────────────────────────
# Generate a secure 256-bit secret: any long random string works
JWT_SECRET=yoursecretkey
JWT_EXPIRY_MS=561600000

# ── QR Code Settings ───────────────────────────────────────────────────
# How many seconds a QR code stays valid after generation
QR_EXPIRY_SECONDS=300

# ── App Settings ───────────────────────────────────────────────────────
APP_PORT=8080
MINIMUM_ATTENDANCE_PERCENT=75
